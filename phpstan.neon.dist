includes:
    - __SHOPWARE_CORE_DIR__/DevOps/StaticAnalyze/PHPStan/common.neon

parameters:
    tmpDir: __PHPSTAN_TMP_DIR__
    paths:
        - src
        - tests

    bootstrapFiles:
        - __SHOPWARE_CORE_DIR__/DevOps/StaticAnalyze/phpstan-bootstrap.php

    symfony:
        constantHassers: false

    ignoreErrors:
        -
            identifier: new.deprecatedClass
            path: src/SwagMcpDevToolsBundle.php
        -
            identifier: method.deprecatedClass
            path: src/SwagMcpDevToolsBundle.php
        -
            identifier: parameter.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: property.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: varTag.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: method.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: missingType.generics
            path: tests
        -
            identifier: return.deprecatedClass
            path: tests
        -
            identifier: classConstant.deprecatedClass
            path: tests
        -
            identifier: property.deprecatedClass
            path: tests
        # Shopware core's TestRuleHelper hardcodes the unit-test namespaces it
        # recognizes (Shopware\Tests\Unit\, ...) and does not include plugin
        # namespaces, so it wrongly rejects #[CoversClass] on our unit tests.
        -
            identifier: shopware.unexpectedTestCovers
            path: tests
        # Some Shopware entities (e.g. NotificationEntity, ImportExportLogEntity,
        # Progress) are flagged as too simple to mock; mocking them keeps the
        # tests isolated and is intentional here.
        -
            identifier: shopware.mockingSimpleObjects
            path: tests
