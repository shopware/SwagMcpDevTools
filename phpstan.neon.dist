includes:
    - __SHOPWARE_CORE_DIR__/DevOps/StaticAnalyze/PHPStan/common.neon

parameters:
    tmpDir: __PHPSTAN_TMP_DIR__
    paths:
        - src
        - tests

    bootstrapFiles:
        - __SHOPWARE_CORE_DIR__/DevOps/StaticAnalyze/phpstan-bootstrap.php

    symfony:
        constantHassers: false

    ignoreErrors:
        -
            identifier: new.deprecatedClass
            path: src/SwagMcpDevToolsBundle.php
        -
            identifier: method.deprecatedClass
            path: src/SwagMcpDevToolsBundle.php
        -
            identifier: parameter.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: property.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: varTag.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: method.deprecatedClass
            path: src/Mcp/Tool/NotificationsTool.php
        -
            identifier: missingType.generics
            path: tests
        -
            identifier: method.unresolvableReturnType
            path: tests
        -
            identifier: return.deprecatedClass
            path: tests
        -
            identifier: classConstant.deprecatedClass
            path: tests
        -
            identifier: varTag.deprecatedClass
            path: tests
        -
            identifier: method.deprecatedClass
            path: tests
        -
            identifier: property.deprecatedClass
            path: tests
